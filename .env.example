# Copy to .env and fill in. Never commit .env.

# Which LLM adapter to use: fake | openrouter | anthropic
# fake = offline keyword rules + template replies (no key needed; for CI and quick demos).
LLM_PROVIDER=fake

# OpenRouter (development and cross-provider evals; synthetic data only)
OPENROUTER_API_KEY=
# Model slug as listed on openrouter.ai/models
OPENROUTER_MODEL=

# Anthropic (intended production adapter)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# USD per million tokens (check the pricing page); needed for cost metering and eval budgets
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=

# Optional: ElevenLabs voice for the /voice page (otherwise the browser's own voice speaks).
# Voice ids are listed in your ElevenLabs account; the model defaults to eleven_multilingual_v2.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional: WhatsApp Cloud API (Meta developer app; the free test number is enough for demos).
# All four of token, phone number id, verify token and app secret are needed to turn it on.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (used to check that webhooks really come from Meta).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0
# Optional, paid: an approved template name for messages more than 24 h after the last reply.
WHATSAPP_REMINDER_TEMPLATE=

# Storage
DATABASE_URL=sqlite:///./data/sazon.db

# Client configuration to load (app/config/<CLIENT_ID>.yaml)
CLIENT_ID=grupo_sazon

# Demo mode: lets the chat page fast-forward the clock to show reminders.
DEMO_MODE=true

# Recruiter login for the demo dashboard (set your own; there is no default)
RECRUITER_USERS=
SESSION_SECRET=
