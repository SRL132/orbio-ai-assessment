# Copy to .env and fill in. Never commit .env.

# Which LLM adapter to use: fake | openrouter | anthropic | openai
#   Offline: fake = keyword rules + template replies, no key needed (the default here, and in CI).
#   Demo, on the production models through OpenRouter (synthetic data only): set
#   OPENROUTER_API_KEY and
#     LLM_PROVIDER=openrouter
#     LLM_FALLBACK_PROVIDER=openrouter
#     LLM_FALLBACK_MODEL=anthropic/claude-haiku-5.5
#   Production: openai with the anthropic fallback, the Docker image's defaults. It needs both keys.
LLM_PROVIDER=fake

# OpenRouter (the demo, and cross-provider evals; synthetic data only)
OPENROUTER_API_KEY=
# Model slug as listed on openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-5.6-terra
# Hidden reasoning per call (none, minimal, low…; empty = the model's default). Less is faster:
# Qwen 3.8 Flash takes ~25 s a turn at "low" and ~4 s at "none". On Gemini 3.5 Flash-Lite, "low" beat
# "minimal" in the evals. Check per model with --reasoning.
OPENROUTER_REASONING_EFFORT=low

# OpenAI, the production choice (GPT-5.6 Terra; docs/architecture.md, "Where the choice stands")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
# USD per million tokens (check the pricing page); needed for cost metering and eval budgets
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=

# Anthropic (the fallback: Claude Haiku 5.5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# USD per million tokens (check the pricing page); needed for cost metering and eval budgets
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=

# When the provider is slow or down: retries per call (jittered backoff), then the fallback
# provider (fake | openrouter | anthropic | openai; empty = none) with its own model, then the
# candidate's message is held and retried (docs/architecture.md, "LLM calls are hardened").
LLM_MAX_RETRIES=1
# Production fallback: a second vendor that meets the 5 s rule, through its own SDK.
# LLM_FALLBACK_PROVIDER=anthropic  LLM_FALLBACK_MODEL=claude-haiku-5-5
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# LLM calls in flight per process; fleet-wide it's replicas x this, keep it under your rate limit
LLM_MAX_CONCURRENCY=16
# Turns a worker process runs at once (they mostly wait for the LLM)
WORKER_CONCURRENCY=16

# Optional: ElevenLabs voice for the /voice page (otherwise the browser's own voice speaks).
# Voice ids are listed in your ElevenLabs account; the model defaults to eleven_multilingual_v2.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Public address of the app (e.g. https://jobs.example.com, or your ngrok URL). Makes the
# privacy link in the consent message absolute, which WhatsApp needs. Empty: links stay relative.
PUBLIC_BASE_URL=

# Optional: WhatsApp Cloud API (Meta developer app; the test number is enough for demos).
# All four of token, phone number id, verify token and app secret are needed to turn it on.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (used to check that webhooks really come from Meta).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0
# Optional, paid: an approved template name for messages more than 24 h after the last reply.
WHATSAPP_REMINDER_TEMPLATE=
# Off by default. The business number, once replies really reach phones: invites then become
# WhatsApp links with a code instead of web chat links, and a number that writes with no valid
# code is ignored. Needs SESSION_SECRET.
WHATSAPP_INVITE_NUMBER=
# Conversations the outbox sends to at once (each one stays in order)
WHATSAPP_DISPATCH_CONCURRENCY=8

# Places the client config doesn't list (e.g. a town next to Madrid): leave empty to treat
# them as outside the area, or "nominatim" to look them up (OpenStreetMap, free) and decide by
# distance (geo_review_radius_km in the client config). Only the place name is sent. Nominatim's
# usage policy needs an identifying User-Agent with a contact, and max 1 request/s.
GEOCODER=
NOMINATIM_USER_AGENT=
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Storage
DATABASE_URL=sqlite:///./data/sazon.db

# Client configuration to load (app/config/<CLIENT_ID>.yaml)
CLIENT_ID=grupo_sazon

# Demo mode: lets the chat page fast-forward the clock to show reminders.
DEMO_MODE=true
# Set to true on anything public: only a signed link or code starts a conversation.
INVITE_ONLY=false
# Behind a proxy: the header it always overwrites with the caller's address, for rate limits.
# On Render: True-Client-IP. Leave it empty with no proxy, or callers can fake their address.
CLIENT_IP_HEADER=

# Recruiter login for the demo dashboard (set your own; there is no default)
RECRUITER_USERS=
SESSION_SECRET=
# Optional: require "Authorization: Bearer <token>" on /metrics (Prometheus)
METRICS_TOKEN=
# Optional: lets the ATS register applications (POST /api/v1/applications, Bearer token)
ATS_TOKEN=
# Optional: send traces to an OpenTelemetry collector (e.g. http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
